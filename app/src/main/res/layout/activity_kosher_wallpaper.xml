<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/kosherWallpaperBack"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/kosher_wallpaper_back" android:textAllCaps="false"
            android:background="@drawable/ui_secondary_button" android:backgroundTint="@null" app:backgroundTint="@null"
            android:textColor="@color/accent_blue" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/kosher_wallpaper_title" android:textSize="24sp" android:textStyle="bold"
            android:textColor="@color/accent_navy" android:layout_marginTop="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/kosher_wallpaper_explanation" android:textSize="14sp" android:lineSpacingExtra="3dp"
            android:textColor="@color/text_secondary" android:layout_marginTop="10dp" android:layout_marginBottom="16dp" />
        <com.yidream.mdm.KosherWallpaperPreview android:id="@+id/kosherWallpaperPreview"
            android:layout_width="match_parent" android:layout_height="240dp"
            android:contentDescription="@string/kosher_wallpaper_preview" />
        <TextView android:id="@+id/kosherWallpaperStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/kosher_wallpaper_home_only" android:textSize="13sp"
            android:textColor="@color/text_secondary" android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/kosherWallpaperChooseImage"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/kosher_wallpaper_choose_image" android:textAllCaps="false" android:layout_marginTop="14dp"
            android:background="@drawable/ui_secondary_button" android:backgroundTint="@null" app:backgroundTint="@null"
            android:textColor="@color/accent_blue" android:textSize="14sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/kosherWallpaperDefault"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/kosher_wallpaper_default" android:textAllCaps="false" android:layout_marginTop="8dp"
            android:background="@drawable/ui_secondary_button" android:backgroundTint="@null" app:backgroundTint="@null"
            android:textColor="@color/accent_blue" android:textSize="14sp" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/kosherWallpaperApply"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/kosher_wallpaper_apply" android:textAllCaps="false" android:layout_marginTop="12dp"
            android:background="@drawable/ui_primary_button" android:backgroundTint="@null" app:backgroundTint="@null"
            android:textColor="@color/white" android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
