                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="8dp" android:src="@drawable/ic_chevron" android:tint="@color/text_tertiary" android:importantForAccessibility="no" />
              </LinearLayout>
              <TextView android:id="@+id/rowRemoveFilter" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/ui_danger_row" android:foreground="?attr/selectableItemBackground" android:padding="16dp" android:text="@string/about_remove_filter" android:textColor="@color/danger" android:textStyle="bold" android:textSize="13sp" android:clickable="true" android:focusable="true" android:minHeight="52dp" />
            </LinearLayout>
          </LinearLayout>
          <LinearLayout android:id="@+id/settingsPageContact" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:id="@+id/settingsContactContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_glass_card" android:padding="16dp" android:layout_marginTop="0dp" />
