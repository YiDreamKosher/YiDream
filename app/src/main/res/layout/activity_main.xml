                  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_pair_caption" android:textSize="12sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="2dp" android:layout_marginTop="4dp" />
